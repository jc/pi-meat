{
  "name": "pi-meat",
  "version": "0.1.2",
  "description": "pi extension + CLI that abridges code diffs into reading diffs — review agent-written code at the concept level, not the line level",
  "type": "module",
  "exports": {
    ".": "./extensions/index.ts",
    "./api": "./extensions/api.ts"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "code-review",
    "diff",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-pod/pi-meat.git"
  },
  "homepage": "https://github.com/pi-pod/pi-meat",
  "bugs": "https://github.com/pi-pod/pi-meat/issues",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "extensions",
    "cmd",
    "meat",
    "go.mod"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "test": "go test ./... && npm run check && node --test tests/model-bridge.test.mjs",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.0"
  }
}
